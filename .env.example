# ==============================
# CONFIGURAÇÃO PARA VPS / PRODUÇÃO
# ==============================
# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env

# Ambiente
NODE_ENV=production

# Porta do servidor backend (padrão: 3000)
PORT=3000

# Host do servidor (0.0.0.0 para VPS)
HOST=0.0.0.0

# Segredo JWT — MUDE ISSO EM PRODUÇÃO! Use um valor longo e aleatório.
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=mude-isso-para-um-segredo-forte-em-producao

# Senha master de emergência — remova ou troque em produção
MASTER_PASSWORD=troque-essa-senha-master

# Chave da API Gemini (Google AI Studio)
# Obtenha gratuitamente em: https://aistudio.google.com
GEMINI_API_KEY=sua_chave_aqui

# Origens CORS permitidas (separe por vírgula, ou deixe vazio para permitir todas)
# Exemplo: ALLOWED_ORIGINS=https://seudominio.com,https://www.seudominio.com
ALLOWED_ORIGINS=

# ==============================
# NOTAS DE IMPLANTAÇÃO EM VPS
# ==============================
# 1. Instale o Node.js 18+ e o PM2 globalmente:
#    npm install -g pm2
#
# 2. Clone o projeto e instale as dependências:
#    npm install && cd backend && npm install && cd ..
#
# 3. Faça o build do frontend:
#    npm run build
#
# 4. Inicie com PM2 (backend em modo produção):
#    NODE_ENV=production pm2 start backend/server.js --name distribuidora
#    pm2 save && pm2 startup
#
# 5. Configure um proxy reverso (Nginx) apontando para a porta 3000.
#
# 6. Em produção, o backend serve o frontend automaticamente via /dist.
#    Configure o Nginx como proxy reverso:
#
